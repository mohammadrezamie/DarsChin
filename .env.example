# DarsChin — DEVELOPMENT TEMPLATE ONLY. No real passwords, phones, API keys or user data.
# Copy to .env (which is ignored by Git). Never commit the populated copy.

# Required: unique random signing secret for login JWTs (min 32 random bytes).
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Required when initializing the privileged administrator on an instance.
# Mobile: the administrator's Iranian number in canonical 09xxxxxxxxx format.
# Password: at least 16 characters for production, unique and unpredictable.
# Recovery: at least 16 characters for production, distinct from password and JWT.
# Production startup refuses known placeholders, weak/short/reused secrets and MOCK_OTP_CODE.
# Password: strong secret, different from any other service.
# Recovery: separate unpredictable secret; never reuse the login password.
ROOT_OWNER_MOBILE=
ROOT_OWNER_PASSWORD=
ROOT_OWNER_RECOVERY_KEY=

# Access policy for THIS running server: multiuser (normal student accounts)
# or owner_only (only root may access backend APIs; does not hide static/demo).
# Existing installations default to multiuser for compatibility.
DARSCHYN_ACCESS_MODE=multiuser

# After first verified provision AND tested backup/restore set true; stops
# accidental recreation if the existing data mount disappears.
DARSCHYN_REQUIRE_EXISTING_DB=false

# Student mobile ownership must be proved by OTP before public registrations.
# In NODE_ENV=production, registration is blocked (HTTP 503) while this is false.
# Enable true only when a genuine SMS provider and OTP flow work end-to-end.
DARSCHYN_REGISTRATION_OTP_REQUIRED=false

# Optional Cloudflare Turnstile: enable true only after setting site key,
# private server-side secret and comma-separated allowed hostnames.
# false uses the existing server-validated local image CAPTCHA.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# SMS_PROVIDER=log means no real SMS delivery (safe for development).
# For a real provider configure a private API key, approved sender, and OTP approval.
SMS_PROVIDER=log
NIAZPARDAZ_API_KEY=
NIAZPARDAZ_SENDER_NUMBER=
NIAZPARDAZ_SMS_OTP_APPROVED=false
