# JWT_SECRET is required by the authentication middleware to start the server.
# Generate a unique secret locally (at least 32 random bytes); never commit its value.
JWT_SECRET=

# Configure these with private values when bootstrapping a root owner.
ROOT_OWNER_MOBILE=
ROOT_OWNER_PASSWORD=
ROOT_OWNER_RECOVERY_KEY=

# Optional: restrict a self-hosted runtime to the configured root owner.
# Does not hide public files/browser-only demo; proxy protection is separate.
# Values: multiuser (default for compatibility), owner_only.
DARSCHYN_ACCESS_MODE=multiuser
# Prevent missing-volume recreation after first, verified provisioning.
DARSCHYN_REQUIRE_EXISTING_DB=false
# Require SMS proof of phone ownership for new student registrations.
DARSCHYN_REGISTRATION_OTP_REQUIRED=false
# Optional production human challenge. Use real domain keys, never commit secrets.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# OTP provider defaults to log (no delivery). Approved real use requires all settings.
SMS_PROVIDER=log
NIAZPARDAZ_API_KEY=
NIAZPARDAZ_SENDER_NUMBER=
NIAZPARDAZ_SMS_OTP_APPROVED=false

