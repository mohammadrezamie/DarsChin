# DarsChin — STAGING TEMPLATE ONLY. Copy to /etc/darschyn/staging.env privately.
# chmod 600 /etc/darschyn/staging.env ; never commit populated credentials.
# This is for systemd/direct Node staging, NOT the VPS Docker Compose template.
# Staging and production MUST NOT share a database, keys, identity or SMS sender.

# Runs the built Node app, normally behind localhost-only Nginx.
NODE_ENV=production
HOST=127.0.0.1
PORT=3002

# Separate writable directory outside the Git checkout and release tree.
# Verify ownership and choose a unique location for this installation.
DARSCHYN_DATA_DIR=/var/lib/darschyn-staging

# Per-installation backend policy: owner_only or multiuser.
DARSCHYN_ACCESS_MODE=owner_only

# Full 40-character tested commit SHA to compare with /api/health.
DARSCHYN_RELEASE_SHA=

# Secret signing key (32+ random bytes). Never share with production.
JWT_SECRET=

# Private root number (09xxxxxxxxx), strong password, distinct recovery key.
# For existing accounts rotating the ENV alone does not reset stored hashes.
ROOT_OWNER_MOBILE=
ROOT_OWNER_PASSWORD=
ROOT_OWNER_RECOVERY_KEY=

# SMS log = no actual SMS. Real OTP registration requires provider approval,
# proper delivery testing, and DARSCHYN_REGISTRATION_OTP_REQUIRED=true.
SMS_PROVIDER=log
NIAZPARDAZ_API_KEY=
NIAZPARDAZ_SENDER_NUMBER=
NIAZPARDAZ_SMS_OTP_APPROVED=false
DARSCHYN_REGISTRATION_OTP_REQUIRED=false

# Optional hosted CAPTCHA; false uses the local server-validated challenge.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# Only false on first provisioning; true after backup/restore and volume check.
DARSCHYN_REQUIRE_EXISTING_DB=false
