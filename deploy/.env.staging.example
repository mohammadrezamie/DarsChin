# Template ONLY. Copy outside Git to /etc/darschyn/staging.env using an editor.
# Keep staging credentials, file data, domain and SMS entirely separate from production.
NODE_ENV=production
HOST=127.0.0.1
PORT=3002
DARSCHYN_DATA_DIR=/var/lib/darschyn-staging
# Must be the exact FULL 40-character commit used in QA and staging release.
DARSCHYN_RELEASE_SHA=
JWT_SECRET=
ROOT_OWNER_MOBILE=
ROOT_OWNER_PASSWORD=
ROOT_OWNER_RECOVERY_KEY=
SMS_PROVIDER=log
NIAZPARDAZ_API_KEY=
TURNSTILE_ENABLED=false
