# Replace darschyn.example with the real domain before enabling this file.
# Keep the Node service bound to its current internal port; do not expose it publicly.
server {
    listen 80;
    listen [::]:80;
    server_name darschyn.example www.darschyn.example;

    # Optional when this instance is entirely private and the operator has a
    # stable access network: add vetted VPN/IP allow rules here. This protects
    # static pages and /demo, which API owner_only mode does not hide.
    # Do NOT turn on HTTP Basic Auth across all /api paths without designing
    # around bearer-token Authorization headers used by the app.
    # allow 192.0.2.10;  # example only; replace with operator's trusted address
    # deny all;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:3000/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }
}
