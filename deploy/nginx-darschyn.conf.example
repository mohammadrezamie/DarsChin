# Replace darschyn.example with the real domain before enabling this file.
# TEMPLATE ONLY: do not install/reload on the live shared VPS until the
# independent DarsChin service passes scripts/check-vps-readiness.cjs,
# ownership/permission checks, domain/TLS approval and nginx -t.
# Never modify an existing TNA Nginx server block or bind a second proxy.
# Keep the Node service bound to its current internal port; do not expose it publicly.
server {
    listen 80;
    listen [::]:80;
    server_name darschyn.example www.darschyn.example;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:3001/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }
}
