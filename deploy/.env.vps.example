# DarsChin — PUBLIC TEMPLATE; create deploy/.env.vps privately on the VPS.
# chmod 600 deploy/.env.vps ; NEVER commit the populated file.
# Keep an existing server's working values during Git updates; do not
# overwrite its live environment from this blank template.

# GitHub release identity (40-character tested commit SHA; git rev-parse HEAD).
# The health response reports 'unidentified' until set.
DARSCHYN_RELEASE_SHA=

# Localhost port for a shared VPS with existing Nginx, e.g. 3001 if available.
# Existing installs may use 3000; verify the actual Nginx upstream before editing.
DARSCHYN_LOCAL_PORT=3000

# Runtime access for THIS instance, not GitHub visibility.
# owner_only = authenticated root APIs only; multiuser = student accounts.
# For a fully private site, protect static/demo pages at the reverse proxy too.
# This template chooses owner_only for new private installs; existing installs
# retain their configured values. Public self-hosters may choose multiuser.
DARSCHYN_ACCESS_MODE=owner_only

# Required only for the bundled dedicated-VPS Caddy HTTPS proxy.
# Your own domain and certificate notification email, not examples to reuse.
DARSCHYN_DOMAIN=
ACME_CONTACT_EMAIL=

# Unique 32+ random bytes: signs session tokens. Keep private and distinct
# for each installation. Changing it invalidates all existing JWT sessions.
JWT_SECRET=

# Private owner bootstrap identity; 09xxxxxxxxx mobile, strong login password,
# and distinct unpredictable recovery key (both 16+ characters).
# On an EXISTING database, changing the ENV password does NOT change the
# stored hash; use the reviewed offline rotation tool with the app stopped.
ROOT_OWNER_MOBILE=
ROOT_OWNER_PASSWORD=
ROOT_OWNER_RECOVERY_KEY=

# SMS_PROVIDER=log disables real delivery. To enable a real provider supply
# API key, sender number and confirm provider approval for the exact OTP text.
SMS_PROVIDER=log
NIAZPARDAZ_API_KEY=
NIAZPARDAZ_SENDER_NUMBER=
NIAZPARDAZ_SMS_OTP_APPROVED=false

# Optional Cloudflare Turnstile anti-bot verification (server-side secret).
# Set true only with registered domain, site key, secret and allowed hostnames.
# false keeps the first-party server-validated CAPTCHA.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# CRITICAL FOR UPDATES: initial provisioning only = false.
# After verifying the database/backup/restore on its persistent volume set true
# to fail startup instead of silently replacing a missing database.
DARSCHYN_REQUIRE_EXISTING_DB=false

# Require OTP verification before accepting public student registrations.
# Keep disabled for owner-only/private use without SMS. Enable only after
# testing a real provider; CAPTCHA alone does not prove phone ownership.
DARSCHYN_REGISTRATION_OTP_REQUIRED=false
