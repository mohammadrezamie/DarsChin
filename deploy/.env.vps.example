# COPY to deploy/.env.vps and chmod 600. NEVER COMMIT THE REAL FILE.
# DNS A/AAAA must point at your VPS. Caddy manages HTTPS automatically.
# After checkout, set this to the exact 7-40 character hexadecimal commit SHA.
# git rev-parse HEAD
DARSCHYN_RELEASE_SHA=unidentified
# Host-only port for shared Nginx; use 3001 or another unused one if needed.
DARSCHYN_LOCAL_PORT=3000
DARSCHYN_DOMAIN=example.org
ACME_CONTACT_EMAIL=admin@example.org
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Your private bootstrap account. Demo uses separate browser-only fake roles.
ROOT_OWNER_MOBILE=
# At least 16 unpredictable characters; do not reuse another service password.
ROOT_OWNER_PASSWORD=
ROOT_OWNER_RECOVERY_KEY=
# Unified SMS center: safe default is log (no real messages). Never commit real keys.
SMS_PROVIDER=log
NIAZPARDAZ_API_KEY=
NIAZPARDAZ_SENDER_NUMBER=
# True only AFTER your SMS provider has explicitly approved the exact OTP text.
NIAZPARDAZ_SMS_OTP_APPROVED=false

# Human verification: requires a Turnstile widget registered for YOUR new domain.
# Keep off until the browser and Siteverify API are reachable from your actual VPS/clients.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=example.org

