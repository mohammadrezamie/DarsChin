[Unit]
Description=DARSCHYN (DarsChin) web application
After=network.target
Wants=network.target
# Limit crash-loop pressure on a shared 2-GiB VPS.
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=darschyn
Group=darschyn
WorkingDirectory=/opt/darschyn/current
EnvironmentFile=/etc/darschyn/darschyn.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DARSCHYN_DATA_DIR=/var/lib/darschyn
ExecStartPre=/usr/bin/test -r /opt/darschyn/current/dist/server.cjs
ExecStartPre=/usr/bin/test -d /var/lib/darschyn
ExecStart=/usr/bin/node /opt/darschyn/current/dist/server.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/darschyn

[Install]
WantedBy=multi-user.target
