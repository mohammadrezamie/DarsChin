{
  "name": "darschyn",
  "private": true,
  "version": "3.3.6",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/package-extension.cjs && node scripts/build-verify.cjs && vite build && esbuild ./server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "repo:check": "node scripts/check-repo-layout.cjs",
    "docs:check": "node scripts/check-persian-docs.cjs",
    "verify": "node scripts/verify.cjs",
    "smoke:api": "node scripts/smoke-api.cjs",
    "qa:full": "bun run verify && bun run smoke:api",
    "deploy:gate": "node scripts/deploy-target-gate.cjs",
    "repo:public-check": "node scripts/check-public-source.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.3",
    "jalaali-js": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "niazpardazsms": "^1.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "svg-captcha": "^1.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/adm-zip": "^0.6.0",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/jalaali-js": "^1.2.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.1.0"
  }
}
